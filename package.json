{
  "name": "dsh-cloud",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "m0:bundle": "node scripts/m0-bundle.mjs",
    "check:seams": "node scripts/check-seam-shapes.mjs",
    "check:web-boot": "node scripts/check-web-boot.mjs",
    "check:page": "node scripts/check-page.mjs",
    "build:edge": "node scripts/build-edge.mjs",
    "deploy:edge": "node scripts/build-edge.mjs && npx wrangler deploy --config units/edge/wrangler.jsonc",
    "deploy:do": "node scripts/m0-bundle.mjs && npx wrangler deploy --config units/session-do/wrangler.jsonc",
    "deploy:exec": "npx wrangler deploy --config units/exec/wrangler.jsonc",
    "deploy": "npm run deploy:do && npm run deploy:edge"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "wrangler": "^4.123.0",
    "ws": "^8.21.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "workerd",
      "esbuild"
    ],
    "overrides": {
      "@deepseek-ai/dsh-agent-presets": "0.1.1-rc.2",
      "@deepseek-ai/dsh-anonymous-user-id": "0.1.1-rc.2",
      "@deepseek-ai/dsh-atomic-write": "0.1.1-rc.2",
      "@deepseek-ai/dsh-code-runtime": "0.1.1-rc.2",
      "@deepseek-ai/dsh-cordis-host-runner": "0.1.1-rc.2",
      "@deepseek-ai/dsh-file-reference": "0.1.1-rc.2",
      "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
      "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
      "@deepseek-ai/dsh-launch-environment": "0.1.1-rc.2",
      "@deepseek-ai/dsh-sandbox": "0.1.1-rc.2",
      "@deepseek-ai/dsh-session-reference": "0.1.1-rc.2",
      "@deepseek-ai/dsh-tool-workflow": "0.1.1-rc.2"
    }
  }
}
