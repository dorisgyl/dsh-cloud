# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

CLAUDE.md
.claude
# docs/ is a working notebook: measurements, dead ends, and the reasoning
# behind decisions, written for whoever maintains this deployment. Only the
# comparison against upstream is meant for readers of the repository.
docs/*
!docs/parity.md
CONTEXT.md
*.plan
*_plan.md

# Git worktrees
.worktrees/

# Downloaded embedding models (use `just download-model` to fetch)
# Anchored to repo root so it doesn't shadow source dirs like
# crates/storage/src/models/.
/models/

# Spike workspace (throwaway exploration; see spike/knowledge-base-v1 branch)
spike/

# Eval run reports (generated artifacts; keep eval/benchmarks tracked)
eval/reports/

.superpowers/

# Node / pnpm
node_modules/
build/
.wrangler/
*.tsbuildinfo

# Local Access service token, never committed
.access-token
.dev.vars
