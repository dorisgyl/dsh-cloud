{
  // U1 dsh-edge — the only public-facing unit.
  "name": "dsh-edge",
  // A BUILT artifact, not the source. `wrangler deploy` will happily ship a
  // stale bundle: it does not know this file is generated, reports success,
  // and returns a fresh Version ID for nine-hour-old code.
  //
  // That happened. Every edge change across one session -- an identity probe,
  // a rate limiter, an admission gate, an extra forwarded header -- deployed
  // "successfully" and none of it ran. It cost a wrong diagnosis too: a header
  // that never shipped was read as "this identity provider has no email
  // claim", which the Access logs later contradicted.
  //
  // Use `npm run deploy:edge`, which builds first. Same for the session
  // object: `npm run deploy:do`.
  "main": "build/edge.bundle.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets and the API share one Worker on one origin, which removes
  // CORS and cross-origin WebSocket configuration entirely (design 8.3).
  //
  // `run_worker_first` lists the SPA document, and only it. By default the asset
  // server answers a matching path BEFORE the Worker runs, so the Worker never
  // saw `/` at all and the boot manifest it injects into index.html silently did
  // not happen — the deploy succeeded, the page loaded, and nothing was
  // rewritten. Every other file still short-circuits to the asset server, which
  // is what should happen for 120 static files.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html"]
  },

  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "SessionAgentDO", "script_name": "dsh-session-do" }
    ]
  },

  // TENANT only. The Access application's team domain and AUD used to sit here
  // as vars, carrying one deployment's real values into every clone -- and the
  // README told operators to set them with `wrangler secret put`, which a var
  // of the same name silently overrides. A stranger following the instructions
  // exactly would have been pointed at somebody else's Access application.
  //
  // They are secrets now, per deployment:
  //
  //   npx wrangler secret put ACCESS_TEAM_DOMAIN   # <team>.cloudflareaccess.com
  //   npx wrangler secret put ACCESS_AUD           # the application's AUD tag
  //
  // Absent, the edge answers 503 `access-not-configured` rather than serving an
  // unprotected agent.
  "vars": {
    "TENANT": "default"
  }
  // `workers_dev` is deliberately absent. *.workers.dev is blocked outright on
  // some networks, and the failure is invisible: the browser's fetch dies
  // before the WebSocket upgrade, so nothing reaches the Worker's logs and it
  // looks like the service is down. Deploy on your own hostname.
}
