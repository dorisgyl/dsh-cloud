{
  // U1 dsh-edge — the only public-facing unit.
  "name": "dsh-edge",
  "main": "build/edge.bundle.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets and the API share one Worker on one origin, which removes
  // CORS and cross-origin WebSocket configuration entirely (design 8.3).
  "assets": { "directory": "./public", "binding": "ASSETS" },

  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "SessionAgentDO", "script_name": "dsh-session-do" }
    ]
  },

  "vars": {
    "TENANT": "default",

    // From the hostname-based Access application (Zero Trust > Access >
    // Applications > Self-hosted). Worker-level Access would populate
    // `ctx.access` and need none of this, but it breaks WebSocket upgrades —
    // measured, see docs/M1-access.md.
    "ACCESS_TEAM_DOMAIN": "yellow-rain-3570.cloudflareaccess.com",
    "ACCESS_AUD": "71566fd1b03df3cdf0afbfcf3e6ecbd73b3535fded3a6bdff146a2e8e6cde6c4"

    // Local development sets DEV_IDENTITY instead; it is ignored whenever the
    // two values above are present, so a deployment cannot fall back into it.
  }

  // `workers_dev` is deliberately absent. *.workers.dev is blocked outright on
  // some networks, and the failure is invisible: the browser's fetch dies
  // before the WebSocket upgrade, so nothing reaches the Worker's logs and it
  // looks like the service is down. Deploy on your own hostname.
}
