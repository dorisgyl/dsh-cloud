{
  // U1 dsh-edge — the only public-facing unit.
  "name": "dsh-edge",
  "main": "build/edge.bundle.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets and the API share one Worker on one origin, which removes
  // CORS and cross-origin WebSocket configuration entirely (design 8.3).
  "assets": { "directory": "./public", "binding": "ASSETS" },

  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "SessionAgentDO", "script_name": "dsh-session-do" }
    ]
  },

  "vars": {
    "TENANT": "default"
  },

  // Local development populates `ctx.access` with the same shape production
  // does, so there is no separate unauthenticated code path to keep in sync.
  // Delete this block to test what an unprotected request sees.
  // In production, protect the Worker from the Workers dashboard (Access tab)
  // — nothing here changes.
  "access": {
    "dev": {
      "aud": "dsh-cloud-dev",
      "identity": { "email": "dev@localhost" }
    }
  }

  // `workers_dev` is deliberately absent. *.workers.dev is blocked outright on
  // some networks, and the failure is invisible: the browser's fetch dies
  // before the WebSocket upgrade, so nothing reaches the Worker's logs and it
  // looks like the service is down. Deploy on your own hostname.
}
