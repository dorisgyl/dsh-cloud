{
  // M1 step 1: a real Durable Object that assembles the plugin tree and runs
  // one agent turn. Not yet the final U2 configuration — no persistence, no
  // alarm-driven turn loop, no edge in front of it.
  "name": "dsh-session-do",
  "main": "build/u2.bundle.js",
  // node:fs needs >= 2025-09-01. From >= 2026-08-04 nodejs_compat is on by
  // default and these flags become redundant (confirmed during M0).
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "SessionAgentDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionAgentDO"] }
  ]
}
